{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 4
    }
  },

  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    }
  },

  "modules": [
    "break",

    {
      "type": "title",
      "keyColor": "cyan"
    },

    {
      "type": "separator",
      "string": "────────────────────────────"
    },

    {
      "type": "os",
      "key": " OS"
    },

    {
      "type": "kernel",
      "key": " Kernel"
    },

    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },

    {
      "type": "packages",
      "key": "󰏖 Packages"
    },

    {
      "type": "shell",
      "key": " Shell"
    },

    {
      "type": "terminal",
      "key": " Terminal"
    },

    {
      "type": "wm",
      "key": " WM"
    },

    "break",

    {
      "type": "host",
      "key": "󰌢 PC"
    },

    {
      "type": "cpu",
      "key": " CPU"
    },

    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },

    {
      "type": "memory",
      "key": " RAM"
    },

    {
      "type": "disk",
      "key": "󰋊 Disk",
      "folders": "/"
    },

    {
      "type": "display",
      "key": "󰍹 Display"
    },

    {
      "type": "localip",
      "key": "󰩟 Local IP"
    }
  ]
}
